# Application
APP_ENV=development
API_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO
SCHEMA_SYNC_ON_STARTUP=true

# Database
DB_NAME=dwo
DB_USER=dwo_user
DB_PASSWORD=dwo_password
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Runtime URLs
DATABASE_URL=postgresql://dwo_user:dwo_password@localhost:5432/dwo
REDIS_URL=redis://localhost:6379/0
